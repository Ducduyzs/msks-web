# Chỉ biến công khai cho trình duyệt (VITE_* nằm trong bundle). KHÔNG đặt khóa secret ở đây.
VITE_API_MODE=http
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>
# Origin công khai của frontend; https:// → bật HSTS và upgrade-insecure-requests trong header bản build.
VITE_PUBLIC_ORIGIN=http://localhost:5173
# Phút không hoạt động trước khi tự đăng xuất (0 = tắt).
VITE_IDLE_LOGOUT_MINUTES=30
