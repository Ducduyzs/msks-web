# Backend MSKS. Sao chép thành .env (không commit). Biến Supabase có thể đặt ở đây hoặc web/.env.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

MSKS_LLM_PROVIDER=openai          # openai | none
MSKS_LLM_MODEL=gpt-4o-mini        # OPENAI_API_KEY lấy từ biến môi trường
MSKS_DEVICE=cuda
MSKS_COOKIE_SECURE=false          # true khi chạy HTTPS
MSKS_CORS_ORIGINS=http://localhost:5173
# Ngưỡng NLI đã hiệu chỉnh (mục 8.1). Bỏ trống → ngưỡng v11, kết quả gắn nhãn thử nghiệm.
# MSKS_CALIBRATION_ARTIFACT=
# MSKS_NLI_SUPPORT_THRESHOLD=
# MSKS_NLI_CONTRADICTION_THRESHOLD=

# --- Bài giảng / media (LECTURE_ARCHITECTURE.md). Giá trị khởi đầu để profiling.
# Gói Supabase Free giới hạn 50 MB/object → video tải theo phần ≤ MSKS_MEDIA_PART_BYTES.
# MSKS_MEDIA_PART_BYTES=47185920
# MSKS_MAX_MEDIA_BYTES=419430400
# MSKS_MAX_MEDIA_SECONDS=3600
# MSKS_MEDIA_QUOTA_BYTES=838860800
# MSKS_ORIGINAL_GRACE_SECONDS=86400   # xóa video gốc sau 24 h nếu không chọn giữ
# MSKS_FRAME_SAMPLE_SECONDS=5
# MSKS_FRAME_CHANGE_THRESHOLD=0.002   # tỉ lệ điểm ảnh đổi rõ rệt
# MSKS_ASR_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
# MSKS_ASR_MODEL_VI=                   # vd. checkpoint PhoWhisper CT2 để so sánh
# MSKS_ASR_COMPUTE_TYPE=int8_float16
# MSKS_ASR_GLOSSARY=                   # thuật ngữ gợi ý cho ASR khi workspace chưa đặt glossary riêng (PUT /api/workspaces/{id}/asr-glossary)
# MSKS_OCR_ENGINE=easyocr              # easyocr | rapidocr (rapidocr mất dấu tiếng Việt)
# Profile lecture_vi_v1 chưa hiệu chỉnh → nhãn thử nghiệm
# MSKS_LECTURE_CALIBRATION_ARTIFACT=
# MSKS_LECTURE_NLI_SUPPORT_THRESHOLD=
# MSKS_LECTURE_NLI_CONTRADICTION_THRESHOLD=
