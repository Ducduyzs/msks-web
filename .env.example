# Backend MSKS. Sao chép thành .env (không commit). Biến Supabase có thể đặt ở đây hoặc web/.env.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

MSKS_LLM_PROVIDER=openai          # openai | none
MSKS_LLM_MODEL=gpt-4o-mini        # OPENAI_API_KEY lấy từ biến môi trường
MSKS_DEVICE=cuda
MSKS_COOKIE_SECURE=false          # true khi chạy HTTPS
MSKS_CORS_ORIGINS=http://localhost:5173
# Ngưỡng NLI đã hiệu chỉnh (mục 8.1). Bỏ trống → ngưỡng v11, kết quả gắn nhãn thử nghiệm.
# MSKS_CALIBRATION_ARTIFACT=
# MSKS_NLI_SUPPORT_THRESHOLD=
# MSKS_NLI_CONTRADICTION_THRESHOLD=
